      <guid>http://localhost:1313/okra/puzzles/p1000/</guid>
      <description>&lt;p&gt;Winst of verlies zit hem vaak in de details.&lt;/p&gt;&#xA;&lt;p&gt;Wit speelt en &amp;hellip; wint!&lt;/p&gt;&#xA;&lt;p&gt;&lt;img src=&#34;http://localhost:1313/okra/puzzles/p1000/p1000.png&#34; alt=&#34;&#34;&gt;&lt;/p&gt;&#xA;&lt;div style=&#34;position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;&#34;&gt;&#xA;      &lt;iframe allow=&#34;accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen&#34; loading=&#34;eager&#34; referrerpolicy=&#34;strict-origin-when-cross-origin&#34; src=&#34;https://www.youtube.com/embed/TCC8uzoQ1bQ?autoplay=0&amp;amp;controls=1&amp;amp;end=0&amp;amp;loop=0&amp;amp;mute=0&amp;amp;start=0&#34; style=&#34;position: absolute; top: 0; left: 0; width: 100%; height: 100%; border:0;&#34; title=&#34;YouTube video&#34;&gt;&lt;/iframe&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;&lt;p&gt;Je kan de video ook bekijken op &lt;a href=&#34;https://www.dropbox.com/scl/fi/cg0rl1zs017a4i729kzf6/White-Is-Winning.mp4?rlkey=76ubfpy14h99eev8ufqrr7qs1&amp;amp;st=biiwefo1&amp;amp;dl=0&#34;&gt;dropbox&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;Of bekijk hier:&lt;/p&gt;&#xA;&lt;div id=&#34;board&#34;&gt;&amp;#160;&lt;/div&gt;&#xA;&lt;script src=&#34;http://localhost:1313/okra/js/pgnviewer.js&#34;&gt;&lt;/script&gt;&#xA;&lt;script src=&#34;https://rphilips.github.io/okra/js/pgnviewer.js&#34;&gt;&lt;/script&gt;&#xA;&lt;style&gt;&#xA;san   {color: black;}&#xA;&lt;/style&gt;&#xA;&lt;script&gt;&#xA;config = {&#xA;pgn:`{Hint: Blokkeer de toegang van de zwarte toren tot de 8e rij.} &#xA;1. Bh7`, &#xA;position: &#39;8/3P2k1/8/3K4/8/3B3r/8/8 w - - 0 1&#39;, showCoords: true, orientation: &#39;white&#39;, theme: &#39;blue&#39;, pieceStyle: &#39;wikipedia&#39;, figurine: &#39;merida&#39;, locale: &#39;en&#39;, timerTime: &#39;&#39;, layout: &#39;top&#39;, showFen: false, coordsInner: false, manyGames: false, coordsFactor: &#39;1.0&#39;, coordsFontSize: &#39;&#39;, colorMarker: &#39;&#39;, startPlay: &#39;&#39;,  notation: &#39;long&#39;, notationLayout: &#39;list&#39;, resizable: true, headers: false, };&#xA;&#xA;var board = PGNV.pgnPuzzle(&#39;board&#39;, config);&#xA;&lt;/script&gt;</description>
