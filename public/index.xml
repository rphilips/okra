ner: false, manyGames: false, coordsFactor: &#39;1.0&#39;, coordsFontSize: &#39;&#39;, colorMarker: &#39;&#39;, startPlay: &#39;&#39;, hideMovesBefore: true, notation: &#39;long&#39;, notationLayout: &#39;list&#39;, resizable: true, headers: false,};&#xA;&#x9;&#xA;var board = PGNV.pgnPuzzle(&#39;board&#39;, config);&#xA;&lt;/script&gt;</description>
